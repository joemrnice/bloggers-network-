<%- include("partials/head.ejs") %>
<%- include("partials/header.ejs") %>

<main class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
  <section class="rounded-[2rem] border border-white/10 bg-white/5 p-8 sm:p-12">
    <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
      <div>
        <p class="inline-flex items-center rounded-full border border-cyan-300/20 bg-cyan-300/10 px-4 py-1 text-xs font-semibold uppercase tracking-[0.3em] text-cyan-200">Blog feed</p>
        <h1 class="display-font mt-6 text-4xl font-semibold tracking-tight text-white sm:text-5xl">Read, publish, and keep momentum.</h1>
        <p class="mt-4 max-w-2xl text-base leading-8 text-slate-300">The feed now renders real posts from SQLite. When you sign in, the composer appears and the new entry is stored immediately so the page refresh feels dynamic.</p>
      </div>
      <div class="grid gap-3 sm:grid-cols-3 lg:min-w-[26rem]">
        <div class="rounded-3xl border border-white/10 bg-slate-950/60 p-4">
          <p class="text-2xl font-semibold text-white"><%= stats.members %></p>
          <p class="mt-1 text-sm text-slate-400">Members</p>
        </div>
        <div class="rounded-3xl border border-white/10 bg-slate-950/60 p-4">
          <p class="text-2xl font-semibold text-white"><%= stats.posts %></p>
          <p class="mt-1 text-sm text-slate-400">Posts</p>
        </div>
        <div class="rounded-3xl border border-white/10 bg-slate-950/60 p-4">
          <p class="text-2xl font-semibold text-white"><%= stats.messages %></p>
          <p class="mt-1 text-sm text-slate-400">Messages</p>
        </div>
      </div>
    </div>
  </section>

  <% if (typeof errorMessage !== "undefined" && errorMessage) { %>
    <div class="mt-6 rounded-3xl border border-rose-300/20 bg-rose-300/10 px-5 py-4 text-sm text-rose-100"><%= errorMessage %></div>
  <% } %>
  <% if (typeof successMessage !== "undefined" && successMessage) { %>
    <div class="mt-6 rounded-3xl border border-emerald-300/20 bg-emerald-300/10 px-5 py-4 text-sm text-emerald-100"><%= successMessage %></div>
  <% } %>

  <% if (typeof featuredPost !== "undefined" && featuredPost) { %>
    <section class="mt-10 overflow-hidden rounded-[2rem] border border-white/10 bg-slate-950/70 shadow-glow">
      <div class="grid gap-0 lg:grid-cols-2">
        <img src="<%= featuredPost.displayImage %>" alt="<%= featuredPost.title %>" class="h-80 w-full object-cover lg:h-full">
        <div class="p-8 sm:p-10 lg:p-12">
          <p class="text-sm font-semibold uppercase tracking-[0.2em] text-cyan-200">Featured post</p>
          <h2 class="display-font mt-4 text-3xl font-semibold text-white"><%= featuredPost.title %></h2>
          <div class="mt-4 flex items-center gap-3 text-sm text-slate-400">
            <span class="flex h-10 w-10 items-center justify-center rounded-full bg-cyan-400/15 text-xs font-semibold text-cyan-100"><%= featuredPost.initials %></span>
            <div>
              <p class="font-semibold text-slate-100"><%= featuredPost.creatorName %></p>
              <p><%= featuredPost.formattedDate %></p>
            </div>
          </div>
          <p class="mt-5 text-sm leading-7 text-slate-300"><%= featuredPost.content %></p>
        </div>
      </div>
    </section>
  <% } %>

  <section class="mt-10 grid gap-8 lg:grid-cols-[0.95fr_1.05fr]">
    <div class="rounded-[2rem] border border-white/10 bg-white/5 p-6 sm:p-8">
      <div class="flex items-center justify-between gap-4">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.2em] text-cyan-200">Compose</p>
          <h2 class="display-font mt-3 text-2xl font-semibold text-white"><%= currentUser ? "Write a new post" : "Sign in to publish" %></h2>
        </div>
        <% if (currentUser) { %>
          <div class="flex items-center gap-3 rounded-2xl border border-white/10 bg-slate-950/60 px-4 py-3 text-sm text-slate-300">
            <div class="flex h-10 w-10 items-center justify-center overflow-hidden rounded-full bg-cyan-400/20 font-semibold text-cyan-100">
              <% if (currentUser.avatar && currentUser.avatar.startsWith("/")) { %>
                <img src="<%= currentUser.avatar %>" alt="<%= currentUser.name %>" class="h-full w-full object-cover">
              <% } else { %>
                <%= currentUser.name.slice(0, 2).toUpperCase() %>
              <% } %>
            </div>
            <div>
              <p class="font-semibold text-white"><%= currentUser.name %></p>
              <p><%= currentUser.email %></p>
            </div>
          </div>
        <% } %>
      </div>

      <% if (currentUser) { %>
        <form action="/blog/posts" method="post" enctype="multipart/form-data" class="mt-6 space-y-5">
          <div>
            <label for="title" class="mb-2 block text-sm font-medium text-slate-200">Post title</label>
            <input id="title" name="title" type="text" required class="w-full rounded-2xl border border-white/10 bg-slate-950/60 px-4 py-3 text-white outline-none transition placeholder:text-slate-500 focus:border-cyan-300/50 focus:ring-4 focus:ring-cyan-300/10" placeholder="A strong headline">
          </div>
          <div>
            <label for="blog" class="mb-2 block text-sm font-medium text-slate-200">Content</label>
            <textarea id="blog" name="blog" rows="8" required class="w-full rounded-3xl border border-white/10 bg-slate-950/60 px-4 py-3 text-white outline-none transition placeholder:text-slate-500 focus:border-cyan-300/50 focus:ring-4 focus:ring-cyan-300/10" placeholder="Write your post here..."></textarea>
          </div>
          <div>
            <label for="postImage" class="mb-2 block text-sm font-medium text-slate-200">Optional image</label>
            <input id="postImage" name="postImage" type="file" accept="image/*" class="w-full rounded-2xl border border-dashed border-white/15 bg-slate-950/60 px-4 py-3 text-sm text-slate-300 file:mr-4 file:rounded-full file:border-0 file:bg-cyan-400 file:px-4 file:py-2 file:text-sm file:font-semibold file:text-slate-950 hover:border-cyan-300/40">
          </div>
          <button type="submit" class="inline-flex w-full items-center justify-center rounded-full bg-cyan-400 px-6 py-3 text-sm font-semibold text-slate-950 transition hover:bg-cyan-300">Publish post</button>
        </form>
      <% } else { %>
        <div class="mt-6 rounded-[1.75rem] border border-white/10 bg-slate-950/60 p-6 text-sm leading-7 text-slate-300">
          <p>You can browse posts now. To publish, create an account or sign in first so the post can be tied to a real profile.</p>
          <div class="mt-5 flex flex-wrap gap-3">
            <a href="/login" class="rounded-full bg-cyan-400 px-5 py-3 text-sm font-semibold text-slate-950 transition hover:bg-cyan-300">Login</a>
            <a href="/register" class="rounded-full border border-white/15 px-5 py-3 text-sm font-semibold text-white transition hover:bg-white/10">Register</a>
          </div>
        </div>
      <% } %>
    </div>

    <div>
      <div class="grid gap-6">
        <% if (!posts || posts.length === 0) { %>
          <div class="rounded-[2rem] border border-white/10 bg-white/5 p-8 text-slate-300">No posts yet.</div>
        <% } %>
        <% (posts || []).forEach((post) => { %>
          <article class="overflow-hidden rounded-[2rem] border border-white/10 bg-slate-950/70 transition duration-300 hover:-translate-y-1 hover:border-cyan-300/30">
            <img src="<%= post.displayImage %>" alt="<%= post.title %>" class="h-56 w-full object-cover">
            <div class="p-6 sm:p-7">
              <div class="flex items-center gap-3 text-sm text-slate-400">
                <span class="flex h-10 w-10 items-center justify-center rounded-full bg-cyan-400/15 text-xs font-semibold text-cyan-100"><%= post.initials %></span>
                <div>
                  <p class="font-semibold text-slate-100"><%= post.creatorName %></p>
                  <p><%= post.formattedDate %></p>
                </div>
              </div>
              <h3 class="mt-4 text-2xl font-semibold text-white"><%= post.title %></h3>
              <p class="mt-3 text-sm leading-7 text-slate-300"><%= post.excerpt %></p>
              <a href="/blog/<%= post.id %>" class="mt-5 inline-flex text-sm font-semibold text-cyan-200 transition hover:text-cyan-100">Read full post</a>
            </div>
          </article>
        <% }); %>
      </div>
    </div>
  </section>
</main>

<%- include("partials/footer.ejs") %>